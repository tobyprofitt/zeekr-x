# Copy to the private configuration directory described in README.md.
ZEEKR_MAIN_USERNAME=
ZEEKR_MAIN_PASSWORD=
ZEEKR_COUNTRY_CODE=AU

# App-specific values for the API client.
ZEEKR_HMAC_ACCESS_KEY=
ZEEKR_HMAC_SECRET_KEY=
ZEEKR_PASSWORD_PUBLIC_KEY=
ZEEKR_PROD_SECRET=
ZEEKR_VIN_KEY=
ZEEKR_VIN_IV=

# Optional. Leave blank to select the first vehicle on the account.
ZEEKR_VIN=

# Optional overrides for the session capture helper.
# ZEEKR_REGION_CODE=SEA
# ZEEKR_APP_SERVER_HOST=
# ZEEKR_USERCENTER_HOST=
# ZEEKR_MESSAGE_HOST=
